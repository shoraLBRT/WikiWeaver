{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "globPattern": "wikiweaver.react/src/**/*.{ts,tsx}",
        "hooks": [
          {
            "type": "command",
            "command": "cd wikiweaver.react && npm run lint -- --fix",
            "timeout": 30,
            "statusMessage": "Linting..."
          }
        ]
      }
    ]
  }
}
